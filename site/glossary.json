{
  "terms": [
    {
      "id": "scaling-laws",
      "zh": "规模法则",
      "en": "Scaling Laws",
      "category": "人工智能与计算",
      "aliases": ["规模法则", "scaling laws", "Scaling Laws"],
      "definition": "指随着模型参数量、训练数据规模和算力的同步扩大，模型性能往往会按可预测的幂律规律持续提升，是当代大模型研发的核心经验规律。"
    },
    {
      "id": "bitter-lesson",
      "zh": "苦涩的教训",
      "en": "The Bitter Lesson",
      "category": "人工智能与计算",
      "aliases": ["苦涩的教训", "Bitter Lesson"],
      "definition": "强化学习先驱 Rich Sutton 在 2019 年提出的著名观察：长期来看，依赖大量算力和数据的通用学习方法，几乎总能战胜人工编写先验规则的系统。"
    },
    {
      "id": "transformer",
      "zh": "Transformer 架构",
      "en": "Transformer",
      "category": "人工智能与计算",
      "aliases": ["Transformer"],
      "definition": "基于自注意力机制的神经网络架构。它不仅驱动了现代大语言模型，也通过把氨基酸、基因或空间位置当成「词元」，成为科学基础模型的核心底座。"
    },
    {
      "id": "diffusion-model",
      "zh": "扩散模型",
      "en": "Diffusion Model",
      "category": "人工智能与计算",
      "aliases": ["扩散模型", "diffusion models", "diffusion model"],
      "definition": "一类先学习如何给数据逐步加噪、再学习逆向「去噪生成」的生成式模型，最初用于图像生成，如今广泛用于从零生成三维分子与蛋白质结构。"
    },
    {
      "id": "self-supervised",
      "zh": "自监督学习",
      "en": "Self-Supervised Learning",
      "category": "人工智能与计算",
      "aliases": ["自监督学习", "self-supervised learning"],
      "definition": "不需要人工逐条贴标签，而是让模型直接从海量原始数据自身构造预测任务（例如遮住一段序列让它补全），从而学出底层规律。"
    },
    {
      "id": "masked-lm",
      "zh": "掩码语言建模",
      "en": "MLM / MAE · Masked Modeling",
      "category": "人工智能与计算",
      "aliases": ["掩码语言建模", "掩码自编码器"],
      "definition": "故意遮住序列或数据矩阵中的一部分位置，训练模型根据上下文把缺失内容还原出来，常用于训练蛋白质与单细胞基础模型。"
    },
    {
      "id": "mae",
      "zh": "平均绝对误差",
      "en": "MAE · Mean Absolute Error",
      "category": "人工智能与计算",
      "aliases": ["平均绝对误差", "MAE"],
      "definition": "衡量模型预测值与真实值之间绝对差值平均数的指标。但在单细胞表达等极度稀疏的数据里，只看 MAE 容易被大量零值掩盖真实差异。"
    },
    {
      "id": "active-learning",
      "zh": "主动学习",
      "en": "Active Learning",
      "category": "人工智能与计算",
      "aliases": ["主动学习", "active learning"],
      "definition": "让模型边学边挑最有信息量的新样本去做实验测试，再把实测结果喂回模型迭代，从而用更少湿实验次数锁定最优分子或材料。"
    },
    {
      "id": "reinforcement-learning",
      "zh": "强化学习",
      "en": "Reinforcement Learning (RL)",
      "category": "人工智能与计算",
      "aliases": ["强化学习", "reinforcement learning"],
      "definition": "智能体在环境或验证器中不断尝试动作并根据奖励信号调整策略的训练范式，是推理模型和自主科学智能体的关键训练方式。"
    },
    {
      "id": "reasoning-model",
      "zh": "推理模型",
      "en": "Reasoning Model",
      "category": "人工智能与计算",
      "aliases": ["推理模型"],
      "definition": "经过强化学习训练、能够在给出最终答案前在内部展开长链条推演与自我检查的AI模型，擅长处理数学证明与复杂科学推导。"
    },
    {
      "id": "chain-of-thought",
      "zh": "思维链",
      "en": "Chain of Thought (CoT)",
      "category": "人工智能与计算",
      "aliases": ["思维链"],
      "definition": "让模型把复杂问题拆解成一连串中间推理步骤再得出结论的方式，相当于给了模型在纸上打草稿的计算时间。"
    },
    {
      "id": "world-model",
      "zh": "世界模型",
      "en": "World Model",
      "category": "人工智能与计算",
      "aliases": ["世界模型", "world models", "world model"],
      "definition": "能够在内部表征物理、化学或生物系统运作规则，并在实施真实干预前推演「如果这样做会发生什么」的模型。"
    },
    {
      "id": "sparse-autoencoder",
      "zh": "稀疏自编码器",
      "en": "SAE · Sparse Autoencoder",
      "category": "人工智能与计算",
      "aliases": ["稀疏自编码器", "SAE"],
      "definition": "一种机制可解释性工具，用来把大模型内部高度纠缠的神经元激活拆解成少数稀疏、人类能读懂的生物学或物理概念。"
    },
    {
      "id": "neural-operator",
      "zh": "神经算子",
      "en": "Neural Operator",
      "category": "人工智能与计算",
      "aliases": ["神经算子", "neural operators", "Neural Operator"],
      "definition": "专门学习连续函数空间之间映射关系的神经网络架构，不像普通网络那样受限于固定网格分辨率，适合流体力学与气象偏微分方程求解。"
    },
    {
      "id": "gnn",
      "zh": "图神经网络",
      "en": "GNN · Graph Neural Network",
      "category": "人工智能与计算",
      "aliases": ["图神经网络", "graph neural networks", "GNN"],
      "definition": "把原子、化学键或节点关系直接表示成图结构并沿连接传递信息的神经网络，常用于分子性质预测与三维物理建模。"
    },
    {
      "id": "vae",
      "zh": "变分自编码器",
      "en": "VAE · Variational Autoencoder",
      "category": "人工智能与计算",
      "aliases": ["变分自编码器", "variational autoencoders", "VAE"],
      "definition": "能把高维分子或图像数据压缩到连续隐空间、再从隐空间采样生成新样本的经典深度生成架构。"
    },
    {
      "id": "ssm",
      "zh": "状态空间模型",
      "en": "SSM · State Space Model",
      "category": "人工智能与计算",
      "aliases": ["状态空间模型", "StripedHyena"],
      "definition": "以固定状态演化处理超长序列的架构（如 StripedHyena / Mamba）。相比标准注意力机制，它能以更低显存开销直接处理百万碱基级的完整基因组。"
    },
    {
      "id": "mcmc",
      "zh": "马尔可夫链蒙特卡洛",
      "en": "MCMC · Markov Chain Monte Carlo",
      "category": "人工智能与计算",
      "aliases": ["马尔可夫链蒙特卡洛", "MCMC"],
      "definition": "一类通过在状态空间随机游走来从复杂概率分布中抽样的经典统计与物理计算方法，常用于材料构型或分子热力学模拟。"
    },
    {
      "id": "svm",
      "zh": "支持向量机",
      "en": "SVM · Support Vector Machine",
      "category": "人工智能与计算",
      "aliases": ["支持向量机", "SVM"],
      "definition": "在深度学习兴起前广泛使用的经典机器学习分类器，通过寻找最大间隔超平面来区分不同类别的数据样本。"
    },
    {
      "id": "xgboost",
      "zh": "梯度提升树",
      "en": "XGBoost",
      "category": "人工智能与计算",
      "aliases": ["XGBoost"],
      "definition": "基于决策树集成的高效表格数据建模算法，至今仍是许多药物小分子筛选基准测试里极难被神经网络轻松拉开的强基线。"
    },
    {
      "id": "out-of-distribution",
      "zh": "分布外泛化",
      "en": "OOD · Out-of-Distribution",
      "category": "人工智能与计算",
      "aliases": ["分布外", "out-of-distribution", "OOD"],
      "definition": "考验模型在面对与训练集结构、细胞系或环境条件完全不同的全新样本时，能否依然做出准确预测的能力。"
    },
    {
      "id": "open-weights",
      "zh": "开放权重",
      "en": "Open Weights",
      "category": "人工智能与计算",
      "aliases": ["开放权重", "开源权重", "open weights"],
      "definition": "将训练好的模型参数文件公开发布、允许研究者下载本地部署或再训练的做法；其开放与商用授权边界在生物安全领域尤为敏感。"
    },
    {
      "id": "computer-vision",
      "zh": "计算机视觉",
      "en": "Computer Vision",
      "category": "人工智能与计算",
      "aliases": ["计算机视觉", "computer vision"],
      "definition": "让机器从图像、视频或显微镜切片中识别形态特征、跟踪目标并提取定量信息的人工智能分支。"
    },
    {
      "id": "token",
      "zh": "词元",
      "en": "Token",
      "category": "人工智能与计算",
      "aliases": ["词元", "tokens", "token"],
      "definition": "序列模型处理的基本最小单元；在科学模型里，一个词元可以是单个氨基酸、DNA 碱基、化学键符号，或一小块空间组织切片。"
    },
    {
      "id": "alphafold",
      "zh": "AlphaFold 蛋白质结构预测模型",
      "en": "AlphaFold / AlphaFold 3",
      "category": "生物与新药",
      "aliases": ["AlphaFold-Multimer", "AlphaFold"],
      "definition": "Google DeepMind 开发的里程碑式人工智能系统，首次将仅凭氨基酸序列预测蛋白质静态三维结构的精度推进到接近实验测定水平。"
    },
    {
      "id": "pdb",
      "zh": "蛋白质数据库",
      "en": "PDB · Protein Data Bank",
      "category": "生物与新药",
      "aliases": ["蛋白质数据库", "PDB"],
      "definition": "全球生命科学界共享的实验测定三维生物大分子结构档案馆，收录了七十多年来通过 X 射线晶体学和冷冻电镜积累的结构真值。"
    },
    {
      "id": "msa",
      "zh": "多序列比对",
      "en": "MSA · Multiple Sequence Alignment",
      "category": "生物与新药",
      "aliases": ["多序列比对", "MSA"],
      "definition": "把不同物种里的同源蛋白质序列排在一起比对，借演化过程中「一处突变另一处协同补偿」的共演化信号反推三维接触关系。"
    },
    {
      "id": "protein-lm",
      "zh": "蛋白质语言模型",
      "en": "Protein Language Model",
      "category": "生物与新药",
      "aliases": ["蛋白质语言模型", "protein language model"],
      "definition": "将蛋白质氨基酸序列视作一种「生命语言」的大模型，直接从海量天然序列中学习折叠规律与功能约束，甚至可在无序列比对下设计新蛋白。"
    },
    {
      "id": "co-folding",
      "zh": "共折叠",
      "en": "Co-folding",
      "category": "生物与新药",
      "aliases": ["共折叠", "co-folding"],
      "definition": "把蛋白质靶标和小分子配体或抗体放在同一个模型中联合预测它们结合后的复合物三维结构，比传统先算蛋白再硬塞小分子更贴近真实诱导契合。"
    },
    {
      "id": "conformation",
      "zh": "构象",
      "en": "Conformation",
      "category": "生物与新药",
      "aliases": ["构象", "conformation"],
      "definition": "同一个蛋白质或分子在热运动和环境变化下能够采取的不同三维空间形态；许多药物成败取决于能否精准结合某个瞬间动态构象。"
    },
    {
      "id": "binding-affinity",
      "zh": "结合亲和力",
      "en": "Binding Affinity",
      "category": "生物与新药",
      "aliases": ["结合亲和力", "binding affinity"],
      "definition": "量化药物小分子或抗体与靶标蛋白粘合得有多牢固的指标（常用 IC50 或 Kd 表示），直接决定了药效强弱与最低有效剂量。"
    },
    {
      "id": "molecular-docking",
      "zh": "分子对接",
      "en": "Molecular Docking",
      "category": "生物与新药",
      "aliases": ["分子对接", "小分子对接", "molecular docking"],
      "definition": "计算小分子化合物以什么姿势和角度嵌入靶标蛋白活性口袋的计算方法，是虚拟药物筛选最基础的一道关卡。"
    },
    {
      "id": "ligand",
      "zh": "配体",
      "en": "Ligand",
      "category": "生物与新药",
      "aliases": ["配体", "ligand"],
      "definition": "在生物中指能够特异性结合到靶标蛋白或受体上的小分子药物或信号分子；在配位化学中则指结合在中心金属离子周围的基团。"
    },
    {
      "id": "target",
      "zh": "药物靶点",
      "en": "Drug Target",
      "category": "生物与新药",
      "aliases": ["靶点"],
      "definition": "疾病通路中负责关键生理功能、药物分子需要精准结合并调控的生物大分子（通常是特定蛋白质或核酸）。"
    },
    {
      "id": "antibody",
      "zh": "抗体",
      "en": "Antibody",
      "category": "生物与新药",
      "aliases": ["单克隆抗体", "抗体"],
      "definition": "免疫系统用来精确识别病毒或病变细胞的 Y 形大分子蛋白质，相比传统小分子药分子量更大、特异性高且研发周期通常更长。"
    },
    {
      "id": "cdr-loops",
      "zh": "互补决定区环",
      "en": "CDR Loops · Complementarity-Determining Regions",
      "category": "生物与新药",
      "aliases": ["互补决定区环", "互补决定区", "CDR loops", "CDR"],
      "definition": "抗体分子末端负责直接抓握抗原靶点的六段高度可变的柔性环状结构，是 AI 从零设计全新抗体的最关键、也最难算准的部位。"
    },
    {
      "id": "scfv",
      "zh": "单链可变区抗体片段",
      "en": "scFv · Single-Chain Variable Fragment",
      "category": "生物与新药",
      "aliases": ["scFvs", "scFv", "单链可变区"],
      "definition": "只保留抗体识别抗原的核心可变区并串联成的一段小型化蛋白，体积轻巧，便于高通量实验筛测和细胞治疗工程改造。"
    },
    {
      "id": "del",
      "zh": "DNA 编码化合物库",
      "en": "DEL · DNA-Encoded Library",
      "category": "生物与新药",
      "aliases": ["DNA 编码化合物库", "DNA编码化合物库", "DEL"],
      "definition": "给海量合成分子贴上独一无二的 DNA 分子条形码，让实验室能在同一支试管里一次测试亿级分子能否结合靶标，并靠高通量测序读出结合结果。"
    },
    {
      "id": "smiles",
      "zh": "简化分子线性输入规范",
      "en": "SMILES",
      "category": "生物与新药",
      "aliases": ["简化分子线性输入规范", "SMILES"],
      "definition": "用一串 ASCII 文本字符（如 C、O、双键和括号）无歧义地写出分子二维化学结构的标准编码格式，方便交给语言模型或化学软件处理。"
    },
    {
      "id": "selfies",
      "zh": "自引用嵌入字符串",
      "en": "SELFIES",
      "category": "生物与新药",
      "aliases": ["自引用嵌入字符串", "SELFIES"],
      "definition": "一种专门设计用来替代 SMILES 的分子文本表示法，能保证生成模型随机拼出的任意字符串几乎百分百对应化学上合法的分子图。"
    },
    {
      "id": "admet",
      "zh": "药代动力学与毒性性质",
      "en": "ADME / ADMET",
      "category": "生物与新药",
      "aliases": ["ADMET", "ADME"],
      "definition": "吸收（Absorption）、分布（Distribution）、代谢（Metabolism）、排泄（Excretion）与毒性（Toxicity）的缩写，决定结合紧的分子能否真正成为安全口服药。"
    },
    {
      "id": "pcr",
      "zh": "聚合酶链式反应",
      "en": "PCR · Polymerase Chain Reaction",
      "category": "生物与新药",
      "aliases": ["聚合酶链式反应", "PCR"],
      "definition": "在体外把微量特定 DNA 片段以指数级快速扩增千万倍的基础分子生物学技术，常用于在筛选后读出结合分子的条形码。"
    },
    {
      "id": "cro",
      "zh": "合同研究组织",
      "en": "CRO · Contract Research Organization",
      "category": "生物与新药",
      "aliases": ["合同研究组织", "CRO"],
      "definition": "为药企和生物科技公司承接合成化合物、细胞检测或动物实验等外包研发服务的专业实验机构。"
    },
    {
      "id": "clinical-trial",
      "zh": "临床试验",
      "en": "Clinical Trial",
      "category": "生物与新药",
      "aliases": ["临床试验"],
      "definition": "候选药物在获批上市前于人体志愿者和患者中分期测试安全性与疗效的阶段；肿瘤领域临床试验失败率长期高达九成以上。"
    },
    {
      "id": "biomarker",
      "zh": "生物标志物",
      "en": "Biomarker",
      "category": "生物与新药",
      "aliases": ["生物标志物", "biomarker"],
      "definition": "能够客观指示生理病理状态或预测某类患者是否对特定药物起效的基因突变、蛋白表达或影像特征。"
    },
    {
      "id": "tme",
      "zh": "肿瘤微环境",
      "en": "TME · Tumor Microenvironment",
      "category": "生物与新药",
      "aliases": ["肿瘤微环境", "tumor microenvironment"],
      "definition": "实体瘤内部及周围由癌细胞、免疫细胞、血管和基质共同构成的三维生态战场，极大影响免疫疗法能否起效。"
    },
    {
      "id": "checkpoint-inhibitor",
      "zh": "免疫检查点抑制剂",
      "en": "Immune Checkpoint Inhibitor",
      "category": "生物与新药",
      "aliases": ["免疫检查点抑制剂", "免疫检查点"],
      "definition": "通过解除肿瘤对免疫 T 细胞的「刹车信号」（如 PD-1/PD-L1），重新激活患者自身免疫系统攻击癌细胞的现代抗癌疗法。"
    },
    {
      "id": "he-stain",
      "zh": "苏木精与伊红染色",
      "en": "H&E Staining",
      "category": "生物与新药",
      "aliases": ["苏木精与伊红", "H&E 染色", "H&E"],
      "definition": "病理科百年来最通用的组织切片双色染色方法：细胞核呈蓝紫色、细胞质呈粉红色，几乎每家医院的肿瘤活检都会产生海量 H&E 切片。"
    },
    {
      "id": "immunofluorescence",
      "zh": "多重免疫荧光染色",
      "en": "Multiplex Immunofluorescence",
